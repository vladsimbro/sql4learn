{
  "name": "sql4learn",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Interactive SQL learning academy built with PGlite",
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs",
    "test:browser": "node tests/browser.test.mjs && node tests/browser-runtime.mjs",
    "build": "node scripts/build.mjs",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "playwright": "1.65.0"
  }
}
